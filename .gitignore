node_modules
.env
# Every .env VARIANT too, not just the file itself. A key rotation or a hurried
# debug session leaves .env.bak / .env.local / .env.2026-09-12 sitting next to
# the real one, holding the same live keys — and a bare ".env" rule does not
# match any of them, so the next "git add ." commits the secrets.
# .env.example is the deliberate exception: it is the template, and carries
# names without values.
.env.*
!.env.example
# The self-hosted MongoDB replica-set keyfile: a secret that lives on the server only.
mongo-keyfile
*.log
# Runtime data — never commit (uploaded PDFs, study materials, WhatsApp sessions)
uploads/
examPdfs/
materials/
assignments/
videos/
.wwebjs_auth/
sbom.cdx.json

# Live whiteboard write-ahead journal (runtime, per-instance)
live-journal/

# Curriculum source store (CURRICULUM_DIR). Teachers' uploaded textbook chapters —
# other people's copyrighted material, sometimes hundreds of MB, and the bytes every
# published citation is pinned to. It belongs on a volume, never in the repo.
lessonAssets/
